// =====================================================================
// SFDC Hygiene Weekly - per-specialist hygiene scores
// Paste this into the Power BI action:
//   "Run a query against a dataset" -> Query text
//
// Returns one row per IB specialist:
//   [SpecialistName]  - 'Opp Id Break Down'[IB specialist]
//   [SpecialistEmail] - 'Opp Id Break Down'[IB email]
//   [HygieneScore]    - share of opps flagged for hygiene (0 = perfect,
//                       i.e. 100% hygiene -> these people get the shoutout)
//
// The filters below mirror the report filters:
//   Is Relevant Op? = Y (all pages), Current Quarter = "Current Quarter",
//   IB Specialist / Manager / Services Call not blank
// EXCEPT "Is Hygiene flag? = Y". That one is only a display filter on the
// report page - applying it here would make everyone look 100% flagged,
// so it must NOT be included.
// =====================================================================
DEFINE
    // Same logic as the model measure:
    // Hygiene by seller =
    //   DIVIDE(
    //     COUNTROWS(FILTER('Opp Id Break Down','Opp Id Break Down'[Is Hygiene flag?]="Y")),
    //     COUNTROWS('Opp Id Break Down'))
    // NOTE: COUNTROWS over an empty table returns BLANK(), not 0, and
    // SUMMARIZECOLUMNS drops rows whose only measure is blank - which
    // would silently remove exactly the 100%-hygiene people from the
    // result. COALESCE forces a true 0 for sellers with no flagged opps.
    MEASURE 'Opp Id Break Down'[Hygiene score (flow)] =
        DIVIDE(
            COALESCE(
                COUNTROWS(
                    FILTER(
                        'Opp Id Break Down',
                        'Opp Id Break Down'[Is Hygiene flag?] = "Y"
                    )
                ),
                0
            ),
            COUNTROWS('Opp Id Break Down')
        )

EVALUATE
VAR SellerScores =
    SUMMARIZECOLUMNS(
        'Opp Id Break Down'[IB specialist],
        'Opp Id Break Down'[IB email],

        // ---- report filters, replicated ------------------------------
        // Is Relevant Op? = Y   (all-pages filter)
        TREATAS({"Y"}, 'Opp Id Break Down'[Is Relevant Op?]),

        // Current Quarter Filter = "Current Quarter"
        TREATAS({"Current Quarter"}, 'Opp Id Break Down'[Current Quarter Filter]),

        // IB Specialist is not blank
        FILTER(
            ALL('Opp Id Break Down'[IB specialist]),
            NOT ISBLANK('Opp Id Break Down'[IB specialist])
                && 'Opp Id Break Down'[IB specialist] <> ""
        ),

        // Manager is not blank
        FILTER(
            ALL('Opp Id Break Down'[Manager]),
            NOT ISBLANK('Opp Id Break Down'[Manager])
                && 'Opp Id Break Down'[Manager] <> ""
        ),

        // Services Call is not blank
        FILTER(
            ALL('Opp Id Break Down'[Services Call]),
            NOT ISBLANK('Opp Id Break Down'[Services Call])
                && 'Opp Id Break Down'[Services Call] <> ""
        ),
        // --------------------------------------------------------------

        "@HygieneScore", [Hygiene score (flow)]
    )
RETURN
    SELECTCOLUMNS(
        FILTER(
            SellerScores,
            NOT ISBLANK('Opp Id Break Down'[IB email])
                && NOT ISBLANK('Opp Id Break Down'[IB specialist])
        ),
        "SpecialistName",  'Opp Id Break Down'[IB specialist],
        "SpecialistEmail", 'Opp Id Break Down'[IB email],
        "HygieneScore",    [@HygieneScore]
    )
ORDER BY [SpecialistName]
