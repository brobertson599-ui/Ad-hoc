---
import BaseLayout from '../layouts/BaseLayout.astro';
import OpenStatus from '../components/OpenStatus.astro';
import { restaurant } from '../data/restaurant';

// Proper hero, photography and palette come in Phase 3. This page exists now to
// prove the data file drives everything.
---

<BaseLayout
  title={`${restaurant.name} — ${restaurant.tagline}, ${restaurant.address.town}`}
  description={`Family-run Italian restaurant and grill in ${restaurant.address.town}. Book a table, browse the menu, or order takeaway.`}
>
  <section class="hero">
    <p class="eyebrow">{restaurant.address.town}, {restaurant.address.county}</p>
    <h1>{restaurant.name}</h1>
    <p class="tagline">{restaurant.tagline}</p>

    <OpenStatus />

    <p class="actions">
      <a class="button" href={`tel:${restaurant.phoneHref}`}>
        Call {restaurant.phone}
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    color: var(--claret);
  }

  h1 {
    margin: 0.4rem 0 0;
    font-size: clamp(3rem, 12vw, 5.5rem);
    font-family: ui-serif, Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .tagline {
    margin: 0.25rem 0 1.75rem;
    font-size: clamp(1rem, 3.5vw, 1.25rem);
    color: var(--muted);
  }

  .actions {
    margin: 2rem 0 0;
  }

  .button {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 2px;
    background: var(--claret);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  .button:hover {
    background: #571620;
  }
</style>
