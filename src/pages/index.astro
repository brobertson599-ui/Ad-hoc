---
// Everything between the --- lines is JavaScript that runs when the page is BUILT,
// never in the visitor's browser. Anything you declare here can be used below.
// This is the only "programming" concept you need for Phase 1.
const pageTitle = 'La Casa — Italian Restaurant & Grill, Weybridge';
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <!-- Keeps the demo out of Google. Removed only at launch. -->
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <main>
      <p class="eyebrow">Weybridge, Surrey</p>
      <h1>La Casa</h1>
      <p class="tagline">Italian restaurant &amp; grill</p>
      <p class="status">Phase 1 complete — the project builds and runs.</p>
    </main>
  </body>
</html>

<style>
  /* Styles written here apply to this page only. Global styles arrive in Phase 3. */
  :root {
    --ink: #1b1614;
    --paper: #f7f3ee;
    --claret: #6d1f2b;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--paper);
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    text-align: center;
    padding: 1.5rem;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    color: var(--claret);
  }

  h1 {
    margin: 0.4rem 0 0;
    /* Scales smoothly between phone and desktop with no breakpoints. */
    font-size: clamp(3rem, 12vw, 6rem);
    font-family: ui-serif, Georgia, 'Times New Roman', serif;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: 0.25rem 0 2.5rem;
    font-size: clamp(1rem, 3.5vw, 1.25rem);
    color: #5c534d;
  }

  .status {
    margin: 0;
    font-size: 0.8125rem;
    color: #8a807a;
  }
</style>
